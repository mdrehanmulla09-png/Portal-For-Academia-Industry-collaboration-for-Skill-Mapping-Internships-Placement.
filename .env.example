# ==============================================================================
# SkillBridge India - Environment Configuration (.env.example)
# Government of India Academia-Industry Collaboration Portal (Problem Statement ID: 26044)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Security & Authentication
JWT_SECRET=skillbridge-india-national-portal-secure-key-2026-replace-in-production
JWT_EXPIRES_IN=7d

# Database Configuration
# Defaults to high-performance self-bootstrapping JSON/in-memory data store with zero cloud dependencies.
# To connect to MongoDB Atlas, uncomment and supply your connection URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/skillbridge?retryWrites=true&w=majority

# Cloud Storage (Optional - Local storage adapter is active by default)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=skillbridge-documents
# CLOUDINARY_URL=
